{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestrator.local/protocol/v1/schema.json",
  "title": "AgentConductor Core IPC protocol v1",
  "description": "Language-independent Core IPC envelope and method payload schemas. Compatibility details are in contract.md.",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[\\u0020-\\u007e]+$" },
    "traceContext": { "type": "object", "required": ["traceparent"], "properties": { "traceparent": { "type": "string", "pattern": "^00-(?!0{32}-)[0-9a-f]{32}-(?!0{16}-)[0-9a-f]{16}-[0-9a-f]{2}$" }, "tracestate": { "type": "string", "maxLength": 512, "pattern": "^[\\u0020-\\u007e]*$" } }, "additionalProperties": true },
    "method": { "enum": ["system.health", "system.shutdown", "projects.create", "projects.get", "projects.list", "tasks.create", "tasks.update", "tasks.get", "tasks.list", "tasks.runs.list", "tasks.revisions.list", "tasks.dependencies.add", "tasks.dependencies.list", "workers.register", "skills.install", "mcp.servers.install", "plugins.install", "workers.claim", "leases.heartbeat", "leases.release", "workers.message", "workers.report", "messages.dispatch", "runs.cancel", "runs.reconcile", "policy.evaluate", "approvals.request", "verification.get", "review.request", "acceptance.get", "events.subscribe", "events.replay", "providers.streamTask", "mcp.tools.list", "mcp.tools.call", "plugins.execute", "capabilities.list", "artifacts.get"] },
    "eventType": { "enum": ["task.created", "task.updated", "task.progress", "run.started", "run.state_changed", "worker.message", "review.requested", "review.completed", "acceptance.decided", "recovery.required", "recovery.reconciled"] },
    "methodPayloads": {
      "system.health": { "type": "object" }, "system.shutdown": { "type": "object", "properties": { "deadlineAt": { "type": "string", "format": "date-time" } } },
      "projects.create": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 }, "id": { "$ref": "#/$defs/id" }, "description": { "type": "string" }, "repositoryPath": { "type": ["string", "null"] }, "defaultBranch": { "type": ["string", "null"] } } },
      "projects.get": { "type": "object", "required": ["projectId"], "properties": { "projectId": { "$ref": "#/$defs/id" } } }, "projects.list": { "type": "object" },
      "tasks.create": { "type": "object", "required": ["title", "description", "acceptanceCriteria", "riskTier"], "properties": { "title": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "riskTier": { "enum": [1, 2, 3] }, "projectId": { "type": ["string", "null"] }, "parentTaskId": { "type": ["string", "null"] }, "skillIds": { "type": "array", "items": { "type": "string" } }, "mcpServerIds": { "type": "array", "items": { "type": "string" } }, "pluginIds": { "type": "array", "items": { "type": "string" } }, "tokenBudget": { "type": ["integer", "null"], "minimum": 1 }, "idempotencyKey": { "$ref": "#/$defs/id" } } },
      "tasks.update": { "type": "object", "required": ["taskId", "content"], "properties": { "taskId": { "$ref": "#/$defs/id" }, "content": { "type": "object" } } },
      "tasks.get": { "type": "object", "required": ["taskId"], "properties": { "taskId": { "$ref": "#/$defs/id" } } }, "tasks.list": { "type": "object" },
      "tasks.runs.list": { "type": "object", "required": ["taskId"], "properties": { "taskId": { "$ref": "#/$defs/id" } } },
      "tasks.revisions.list": { "type": "object", "required": ["taskId"], "properties": { "taskId": { "$ref": "#/$defs/id" } } },
      "tasks.dependencies.add": { "type": "object", "required": ["taskId", "dependsOnTaskId"], "properties": { "taskId": { "$ref": "#/$defs/id" }, "dependsOnTaskId": { "$ref": "#/$defs/id" } } },
      "tasks.dependencies.list": { "type": "object", "required": ["taskId"], "properties": { "taskId": { "$ref": "#/$defs/id" } } },
      "workers.register": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 }, "id": { "$ref": "#/$defs/id" }, "kind": { "type": "string" }, "capabilities": { "type": "array", "items": { "type": "object", "required": ["key"], "properties": { "key": { "$ref": "#/$defs/id" }, "version": { "type": "string" } } } } } },
      "skills.install": { "type": "object", "required": ["name", "version", "sourcePath", "instructions"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "sourcePath": { "type": "string", "minLength": 1 }, "instructions": { "type": "string" } } },
      "mcp.servers.install": { "type": "object", "required": ["name", "transport"], "properties": { "name": { "type": "string", "minLength": 1 }, "transport": { "enum": ["stdio", "http"] } } },
      "plugins.install": { "type": "object", "required": ["name", "version", "entrypoint"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "entrypoint": { "type": "string", "minLength": 1 } } },
      "workers.claim": { "type": "object", "required": ["workerId"], "properties": { "workerId": { "$ref": "#/$defs/id" }, "leaseDurationMs": { "type": "integer", "minimum": 1 }, "approvalId": { "$ref": "#/$defs/id" } } },
      "leases.heartbeat": { "type": "object", "required": ["leaseId", "leaseToken"], "properties": { "leaseId": { "$ref": "#/$defs/id" }, "leaseToken": { "$ref": "#/$defs/id" }, "leaseDurationMs": { "type": "integer", "minimum": 1 } } },
      "leases.release": { "type": "object", "required": ["leaseId", "leaseToken", "outcome"], "properties": { "leaseId": { "$ref": "#/$defs/id" }, "leaseToken": { "$ref": "#/$defs/id" }, "outcome": { "enum": ["succeeded", "failed", "cancelled", "inconclusive"] } } },
      "workers.message": { "type": "object", "required": ["leaseToken", "kind", "sequence", "payload"], "properties": { "leaseToken": { "$ref": "#/$defs/id" }, "kind": { "enum": ["progress", "heartbeat", "report", "error"] }, "sequence": { "type": "integer", "minimum": 1 }, "payload": {}, "idempotencyKey": { "$ref": "#/$defs/id" } } },
      "workers.report": { "type": "object", "required": ["leaseToken", "sequence", "outcome", "summary", "source"], "properties": { "leaseToken": { "$ref": "#/$defs/id" }, "sequence": { "type": "integer", "minimum": 1 }, "outcome": { "enum": ["succeeded", "failed", "cancelled", "inconclusive"] }, "summary": { "type": "string" }, "source": { "type": "object", "required": ["adapterId", "sessionId"], "properties": { "adapterId": { "$ref": "#/$defs/id" }, "sessionId": { "$ref": "#/$defs/id" } } } } },
      "messages.dispatch": { "type": "object", "properties": { "now": { "type": "string", "format": "date-time" }, "limit": { "type": "integer", "minimum": 1 } } },
      "runs.cancel": { "type": "object", "required": ["runId", "reason", "deadlineAt"], "properties": { "runId": { "$ref": "#/$defs/id" }, "reason": { "type": "string", "minLength": 1 }, "deadlineAt": { "type": "string", "format": "date-time" } } },
      "runs.reconcile": { "type": "object", "required": ["runId", "observation"], "properties": { "runId": { "$ref": "#/$defs/id" }, "observation": {} } },
      "policy.evaluate": { "type": "object", "required": ["action", "target", "context"], "properties": { "action": {}, "target": {}, "context": { "type": "object" } } },
      "approvals.request": { "type": "object", "required": ["action", "target", "context"], "properties": { "action": {}, "target": {}, "context": { "type": "object" } } },
      "verification.get": { "type": "object", "required": ["runId"], "properties": { "runId": { "$ref": "#/$defs/id" } } },
      "review.request": { "type": "object", "required": ["runId", "evidenceIds"], "properties": { "runId": { "$ref": "#/$defs/id" }, "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } } } },
      "acceptance.get": { "type": "object", "required": ["taskId", "runId"], "properties": { "taskId": { "$ref": "#/$defs/id" }, "runId": { "$ref": "#/$defs/id" } } },
      "events.subscribe": { "type": "object", "properties": { "afterCursor": { "$ref": "#/$defs/id" }, "taskId": { "$ref": "#/$defs/id" }, "runId": { "$ref": "#/$defs/id" } } },
      "events.replay": { "type": "object", "required": ["cursor"], "properties": { "cursor": { "$ref": "#/$defs/id" }, "limit": { "type": "integer", "minimum": 1 } } },
      "providers.streamTask": { "type": "object", "required": ["taskId"], "properties": { "taskId": { "$ref": "#/$defs/id" }, "deadlineAt": { "type": "string", "format": "date-time" }, "systemPrompt": { "type": "string" } } },
      "mcp.tools.list": { "type": "object", "required": ["workerId", "leaseToken", "serverId"], "properties": { "workerId": { "$ref": "#/$defs/id" }, "leaseToken": { "$ref": "#/$defs/id" }, "serverId": { "$ref": "#/$defs/id" } } },
      "mcp.tools.call": { "type": "object", "required": ["workerId", "leaseToken", "serverId", "toolName", "arguments", "sequence"], "properties": { "workerId": { "$ref": "#/$defs/id" }, "leaseToken": { "$ref": "#/$defs/id" }, "serverId": { "$ref": "#/$defs/id" }, "toolName": { "type": "string", "minLength": 1 }, "arguments": { "type": "object" }, "sequence": { "type": "integer", "minimum": 1 } } },
      "plugins.execute": { "type": "object", "required": ["workerId", "leaseToken", "pluginId", "capability", "input", "sequence"], "properties": { "workerId": { "$ref": "#/$defs/id" }, "leaseToken": { "$ref": "#/$defs/id" }, "pluginId": { "$ref": "#/$defs/id" }, "capability": { "type": "string", "minLength": 1 }, "input": {}, "sequence": { "type": "integer", "minimum": 1 } } },
      "artifacts.get": { "type": "object", "required": ["artifactId"], "properties": { "artifactId": { "$ref": "#/$defs/id" } } },
      "capabilities.list": { "type": "object" }
    },
    "requestPayloadValidation": { "allOf": [
      { "if": { "properties": { "method": { "const": "system.health" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/system.health" } } } },
      { "if": { "properties": { "method": { "const": "system.shutdown" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/system.shutdown" } } } },
      { "if": { "properties": { "method": { "const": "projects.create" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/projects.create" } } } },
      { "if": { "properties": { "method": { "const": "projects.get" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/projects.get" } } } },
      { "if": { "properties": { "method": { "const": "projects.list" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/projects.list" } } } },
      { "if": { "properties": { "method": { "const": "tasks.create" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/tasks.create" } } } },
      { "if": { "properties": { "method": { "const": "tasks.update" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/tasks.update" }, "expectedRevision": { "type": "integer", "minimum": 0 } }, "required": ["expectedRevision"] } },
      { "if": { "properties": { "method": { "const": "tasks.get" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/tasks.get" } } } },
      { "if": { "properties": { "method": { "const": "tasks.list" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/tasks.list" } } } },
      { "if": { "properties": { "method": { "const": "tasks.runs.list" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/tasks.runs.list" } } } },
      { "if": { "properties": { "method": { "const": "tasks.revisions.list" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/tasks.revisions.list" } } } },
      { "if": { "properties": { "method": { "const": "tasks.dependencies.add" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/tasks.dependencies.add" }, "expectedRevision": { "type": "integer", "minimum": 0 } }, "required": ["expectedRevision"] } },
      { "if": { "properties": { "method": { "const": "tasks.dependencies.list" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/tasks.dependencies.list" } } } },
      { "if": { "properties": { "method": { "const": "workers.register" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/workers.register" } } } },
      { "if": { "properties": { "method": { "const": "skills.install" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/skills.install" } } } },
      { "if": { "properties": { "method": { "const": "mcp.servers.install" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/mcp.servers.install" } } } },
      { "if": { "properties": { "method": { "const": "plugins.install" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/plugins.install" } } } },
      { "if": { "properties": { "method": { "const": "workers.claim" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/workers.claim" } } } },
      { "if": { "properties": { "method": { "const": "leases.heartbeat" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/leases.heartbeat" } } } },
      { "if": { "properties": { "method": { "const": "leases.release" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/leases.release" } } } },
      { "if": { "properties": { "method": { "const": "workers.message" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/workers.message" } } } },
      { "if": { "properties": { "method": { "const": "workers.report" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/workers.report" } } } },
      { "if": { "properties": { "method": { "const": "messages.dispatch" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/messages.dispatch" } } } },
      { "if": { "properties": { "method": { "const": "runs.cancel" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/runs.cancel" }, "expectedRevision": { "type": "integer", "minimum": 0 } }, "required": ["expectedRevision"] } },
      { "if": { "properties": { "method": { "const": "runs.reconcile" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/runs.reconcile" }, "expectedRevision": { "type": "integer", "minimum": 0 } }, "required": ["expectedRevision"] } },
      { "if": { "properties": { "method": { "const": "policy.evaluate" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/policy.evaluate" } } } },
      { "if": { "properties": { "method": { "const": "approvals.request" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/approvals.request" } } } },
      { "if": { "properties": { "method": { "const": "verification.get" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/verification.get" } } } },
      { "if": { "properties": { "method": { "const": "review.request" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/review.request" }, "expectedRevision": { "type": "integer", "minimum": 0 } }, "required": ["expectedRevision"] } },
      { "if": { "properties": { "method": { "const": "acceptance.get" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/acceptance.get" } } } },
      { "if": { "properties": { "method": { "const": "events.subscribe" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/events.subscribe" } } } },
      { "if": { "properties": { "method": { "const": "events.replay" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/events.replay" } } } },
      { "if": { "properties": { "method": { "const": "providers.streamTask" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/providers.streamTask" } } } },
      { "if": { "properties": { "method": { "const": "mcp.tools.list" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/mcp.tools.list" } } } },
      { "if": { "properties": { "method": { "const": "mcp.tools.call" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/mcp.tools.call" } } } },
      { "if": { "properties": { "method": { "const": "plugins.execute" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/plugins.execute" } } } },
      { "if": { "properties": { "method": { "const": "capabilities.list" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/capabilities.list" } } } },
      { "if": { "properties": { "method": { "const": "artifacts.get" } }, "required": ["method"] }, "then": { "properties": { "payload": { "$ref": "#/$defs/methodPayloads/artifacts.get" } } } }
    ] },
    "sender": { "type": "object", "required": ["id", "role"], "properties": { "id": { "$ref": "#/$defs/id" }, "role": { "$ref": "#/$defs/id" } }, "additionalProperties": true },
    "common": { "type": "object", "required": ["protocolVersion", "messageId", "correlationId", "causationId", "sender"], "properties": { "protocolVersion": { "const": 1 }, "messageId": { "$ref": "#/$defs/id" }, "correlationId": { "$ref": "#/$defs/id" }, "causationId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "sender": { "$ref": "#/$defs/sender" }, "traceContext": { "$ref": "#/$defs/traceContext" } }, "additionalProperties": true },
    "request": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "required": ["kind", "method", "payload"], "properties": { "kind": { "const": "request" }, "method": { "$ref": "#/$defs/method" }, "taskId": { "$ref": "#/$defs/id" }, "runId": { "$ref": "#/$defs/id" }, "attemptId": { "$ref": "#/$defs/id" }, "leaseId": { "$ref": "#/$defs/id" }, "expectedRevision": { "type": "integer", "minimum": 0 }, "deadlineAt": { "type": "string", "format": "date-time" }, "payload": { "type": "object" } }, "$ref": "#/$defs/requestPayloadValidation" }] },
    "error": { "type": "object", "required": ["code", "message", "retryable"], "properties": { "code": { "$ref": "#/$defs/id" }, "message": { "type": "string" }, "retryable": { "type": "boolean" }, "details": { "type": "object" } }, "additionalProperties": true },
    "response": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "required": ["kind", "inReplyTo", "ok"], "properties": { "kind": { "const": "response" }, "inReplyTo": { "$ref": "#/$defs/id" }, "ok": { "type": "boolean" }, "result": {}, "error": { "$ref": "#/$defs/error" } }, "oneOf": [{ "properties": { "ok": { "const": true } }, "required": ["result"] }, { "properties": { "ok": { "const": false } }, "required": ["error"] }] }] },
    "event": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "required": ["kind", "eventType", "sequence", "cursor", "occurredAt", "payload"], "properties": { "kind": { "const": "event" }, "eventType": { "$ref": "#/$defs/eventType" }, "sequence": { "type": "integer", "minimum": 1 }, "cursor": { "$ref": "#/$defs/id" }, "occurredAt": { "type": "string", "format": "date-time" }, "taskId": { "$ref": "#/$defs/id" }, "runId": { "$ref": "#/$defs/id" }, "attemptId": { "$ref": "#/$defs/id" }, "expectedRevision": { "type": "integer", "minimum": 0 }, "payload": { "type": "object" } } }] },
    "capability": { "type": "object", "required": ["name", "state"], "properties": { "name": { "$ref": "#/$defs/id" }, "state": { "enum": ["supported", "unsupported", "conditional", "unverified"] }, "reason": { "type": "string" }, "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "satisfiedPrerequisites": { "type": "array", "items": { "$ref": "#/$defs/id" } } }, "additionalProperties": true },
    "hello": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "required": ["kind", "minimumProtocol", "maximumProtocol", "clientVersion", "schemaVersion", "requiredCapabilities"], "properties": { "kind": { "const": "hello" }, "minimumProtocol": { "type": "integer", "minimum": 1 }, "maximumProtocol": { "type": "integer", "minimum": 1 }, "clientVersion": { "type": "string" }, "schemaVersion": { "type": "integer", "minimum": 0 }, "requiredCapabilities": { "type": "array", "items": { "$ref": "#/$defs/id" } } } }] },
    "welcome": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "required": ["kind", "selectedProtocol", "backendVersion", "buildId", "schemaVersion", "databaseSchemaVersion", "processSupervision", "ready", "capabilities"], "properties": { "kind": { "const": "welcome" }, "selectedProtocol": { "type": "integer", "minimum": 1 }, "backendVersion": { "type": "string" }, "buildId": { "type": "string" }, "schemaVersion": { "type": "integer", "minimum": 0 }, "databaseSchemaVersion": { "type": "integer", "minimum": 0 }, "processSupervision": { "type": "string" }, "ready": { "type": "boolean" }, "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } } } }] }
  }
}
