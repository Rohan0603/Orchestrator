{
  "name": "orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Local Agentic Development Orchestrator",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc --build && node scripts/copy-renderer-assets.mjs",
    "test": "tsc -p tsconfig.test.json && node scripts/run-electron-tests.mjs --expected=10 dist-test/tests/deterministic.test.js && node scripts/run-electron-tests.mjs --expected=5 dist-test/tests/sqlite-runtime.test.js",
    "start": "electron ."
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.8.0",
    "electron": "^44.9.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "electron@44.9.0": true,
    "better-sqlite3@12.11.1": true
  }
}
