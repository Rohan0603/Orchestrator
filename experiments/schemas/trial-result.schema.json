{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchestrator trial result",
  "type": "object",
  "required": [
    "schemaVersion",
    "experimentId",
    "trialId",
    "replicate",
    "sourceRevision",
    "status",
    "validity"
  ],
  "properties": {
    "schemaVersion": { "const": "trial-result-v1" },
    "experimentId": { "type": "string", "minLength": 1 },
    "trialId": { "type": "string", "minLength": 1 },
    "replicate": { "type": "integer", "minimum": 1 },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["accepted", "failed", "blocked", "inconclusive", "invalid", "excluded"]
    },
    "validity": {
      "type": "object",
      "required": ["valid", "reason"],
      "properties": {
        "valid": { "type": "boolean" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
